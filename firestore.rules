rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Profile Rules
    match /users/{userId} {
      // Allow users to read only their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow users to create their own profile only with valid initial roles
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.role in ['customer', 'stallOwner']
                    && request.resource.data.isActive == true;

      // Allow users to update allowed fields (e.g. name, updatedAt, fcmToken, lastLoginAt),
      // but role MUST remain strictly immutable after creation.
      allow update: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.role == resource.data.role;

      // Prevent deletion by clients
      allow delete: if false;
    }
  }
}
