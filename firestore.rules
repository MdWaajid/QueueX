rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStallOwner(stallId) {
      return isAuthenticated()
        && (
          (getUserData().role == 'stallOwner' && getUserData().stallId == stallId)
          ||
          (get(/databases/$(database)/documents/stalls/$(stallId)).data.ownerId == request.auth.uid)
        );
    }

    // User Authorization Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() 
                    && request.auth.uid == userId 
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Stall Authorization Rules
    match /stalls/{stallId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && getUserData().role == 'stallOwner'
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      // Subcollection Slots Rules
      match /slots/{slotId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if false;
      }
    }

    // Food Category Authorization Rules
    match /foodCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                    && isStallOwner(request.resource.data.stallId);
      allow delete: if false;
    }

    // Menu Item Authorization Rules
    match /menuItems/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                    && isStallOwner(request.resource.data.stallId);
      allow delete: if false;
    }

    // Slot Authorization Rules (Top-level)
    match /slots/{slotId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Order Authorization Rules
    match /orders/{orderId} {
      allow read: if isAuthenticated()
                    && (resource.data.customerId == request.auth.uid || isStallOwner(resource.data.stallId));

      allow create: if isAuthenticated()
                    && request.resource.data.customerId == request.auth.uid
                    && (request.resource.data.status.lower() == 'pending' || request.resource.data.status == 'Pending');

      allow update: if isAuthenticated()
                    && (
                      resource.data.customerId == request.auth.uid || isStallOwner(resource.data.stallId)
                    );

      allow delete: if false;

      // Nested OrderItems
      match /orderItems/{itemId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Payment Authorization Rules
    match /payments/{paymentId} {
      allow read: if isAuthenticated()
                    && (resource.data.customerId == request.auth.uid || isStallOwner(resource.data.stallId));

      allow create: if isAuthenticated()
                    && request.resource.data.customerId == request.auth.uid;

      allow update: if isAuthenticated()
                    && (resource.data.customerId == request.auth.uid || isStallOwner(resource.data.stallId));

      allow delete: if false;
    }

    // QR Verification Authorization Rules
    match /qrVerifications/{verificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isStallOwner(request.resource.data.stallId);
      allow update, delete: if false;
    }

    // Notification Authorization Rules
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
